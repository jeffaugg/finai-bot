# Configurações do Telegram
TELEGRAM_BOT_TOKEN="SEU_TOKEN_AQUI"
# Opcional: secret_token do webhook. Se definido, deve ser o mesmo passado no setWebhook
# e é validado via header x-telegram-bot-api-secret-token.
TELEGRAM_WEBHOOK_SECRET=""

# Configurações do Banco de Dados
SUPABASE_URL="SUA_URL_SUPABASE"
SUPABASE_SERVICE_KEY="SUA_CHAVE_PRIVADA_SUPABASE"
# Necessário apenas para rodar migrations (pnpm migrate)
# Formato: postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=""

# Configurações de Inteligência Artificial
GEMINI_API_KEY="SUA_CHAVE_GOOGLE_GEMINI"

# Segurança dos crons da Vercel. Se definido, os endpoints /api/cron/* exigem
# o header Authorization: Bearer <CRON_SECRET> (a Vercel envia automaticamente).
CRON_SECRET=""


